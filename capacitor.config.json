{
  "appId": "com.edunova.app",
  "appName": "Edunova",
  "webDir": "www",
  "backgroundColor": "#0C0E14",
  "server": {
    "url": "https://edunovamis.lovable.app/auth/login?mobile=1",
    "cleartext": false,
    "allowNavigation": [
      "edunovamis.lovable.app",
      "*.lovable.app",
      "*.supabase.co"
    ]
  },
  "android": {
    "backgroundColor": "#0C0E14",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#0C0E14",
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#0C0E14",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0C0E14"
    }
  }
}

{
  "appId": "com.edunova.app",
  "appName": "Edunova",
  "webDir": "www",
  "backgroundColor": "#0C0E14",
  "server": {
    "url": "https://edunovamis.lovable.app/auth/login?mobile=1&ios=1",
    "cleartext": false,
    "allowNavigation": [
      "edunovamis.lovable.app",
      "*.lovable.app",
      "*.supabase.co"
    ]
  },
  "ios": {
    "backgroundColor": "#0C0E14",
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#0C0E14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0C0E14"
    }
  }
}
